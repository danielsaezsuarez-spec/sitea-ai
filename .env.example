# Supabase público del frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endpoint propio/serverless para generación IA.
# No pongas OPENAI_API_KEY en frontend. La clave de OpenAI debe vivir en servidor.
VITE_SITEA_AI_ENDPOINT=

# Futuro checkout Stripe desde backend/serverless
VITE_STRIPE_CHECKOUT_ENDPOINT=

# Dominio base de publicación previsto
VITE_PUBLICATION_BASE_DOMAIN=sitea.ai
